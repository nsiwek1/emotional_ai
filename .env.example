VITE_OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face Inference API (emotion scoring script)
HF_TOKEN=your_huggingface_token_here
HF_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base

# --- Added for survey iframe chatbot ---
# Frontend (Vite) — set to deployed backend URL, or http://localhost:3001 for local dev
VITE_BACKEND_URL=http://localhost:3001

# Backend (Fastify) — CSV of origins permitted to call /chat
ALLOWED_ORIGINS=http://localhost:5173

# Backend port (host platforms usually set this automatically)
PORT=3001

# Optional throttle between HF classify calls (ms). Helps avoid HF rate limits.
HF_SLEEP_MS=0

# OpenAI chat model — defaults to gpt-4o-mini if unset
CONVERSATION_MODEL=gpt-4o-mini
